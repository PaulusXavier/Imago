{
  "name": "office-remote-pc-controller",
  "version": "1.1.0",
  "description": "Roda no computador durante a apresentacao e traduz comandos do celular em teclas do PowerPoint/Prezi",
  "main": "controller.js",
  "bin": "controller.js",
  "scripts": {
    "start": "node controller.js",
    "configurar": "node setup.js",
    "build:win": "pkg . --targets node18-win-x64 --output dist/win/Imago.exe",
    "build:mac": "pkg . --targets node18-macos-x64 --output dist/mac/Imago",
    "build:linux": "pkg . --targets node18-linux-x64 --output dist/linux/Imago",
    "postbuild:win": "node build-copy-native.js win",
    "postbuild:mac": "node build-copy-native.js mac",
    "postbuild:linux": "node build-copy-native.js linux"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "qrcode-terminal": "^0.12.0",
    "robotjs": "^0.6.0",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "setup.js",
      "config.js",
      "thumbnails.js",
      "history.js",
      "updater.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
